# Public site URL (no trailing slash) — metadata & sitemap (set after Railway gives you a URL)
NEXT_PUBLIC_SITE_URL=https://abhiventures.com

# Optional: Cal.com / Calendly
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro

# Optional: WhatsApp E.164 without +
NEXT_PUBLIC_WHATSAPP_E164=

# Static export — optional POST URL for the contact form (JSON body: name, email, details).
# If unset, submit opens the visitor's mail client (mailto).
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://hooks.zapier.com/hooks/catch/...
